dist/
dist-ssr/
out-tsc/
.vite/
*.tsbuildinfo
*.local
*.zip

# Scratch, Agent & Temporary Artifacts
scratch/
.system_generated/
tmp/
.tmp/
.cache/
.local/
coverage/

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IDEs & Editors
.idea/
.ionide/
.vs/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio / .NET (future server & worker modules)
bin/
obj/
[Bb]in/
[Oo]bj/
TestResults/
[Tt]est[Rr]esults/
*.user
*.suo
*.slnx
